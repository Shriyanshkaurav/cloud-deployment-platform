# Example only. Replace with an approved remote backend.
# For Azure Blob state, configure the backend using your organization-approved
# authentication method and storage account/container. Do not put credentials here.
terraform {
  backend "azurerm" {
    resource_group_name  = "REPLACE_WITH_STATE_RESOURCE_GROUP"
    storage_account_name = "REPLACE_WITH_STATE_STORAGE_ACCOUNT"
    container_name       = "tfstate"
    key                  = "deployment-platform/dev.tfstate"
  }
}
